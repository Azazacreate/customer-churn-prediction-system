# Пример переменных окружения.
# Скопируйте этот файл в .env и подставьте свои значения:
#
#     cp .env.example .env
#
# Файл .env в git НЕ коммитится (см. .gitignore), поэтому реальные пароли
# и токены в репозиторий не попадут.

# --- Общие ---
PROJECT_SEED=42
LOG_LEVEL=INFO

# --- Внутренний REST API ---
API_BASE_URL=https://api.internal.example.com/v1
API_TIMEOUT=30
API_TOKEN=

# --- PostgreSQL ---
POSTGRES_ENABLED=false
POSTGRES_DSN=postgresql://user:password@localhost:5432/churn

# --- ClickHouse ---
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=analytics

# --- MLflow ---
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=churn-prediction

# --- Демо-данные (если реальных источников нет) ---
SYNTHETIC_N_SAMPLES=20000
SYNTHETIC_CHURN_RATE=0.14
